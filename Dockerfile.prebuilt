# Runtime-only image. Build the app on the host first (stable network there):
#   npx --yes pnpm@9 install --frozen-lockfile && npx --yes pnpm@9 run build && npx --yes pnpm@9 prune --prod
# then: docker compose -f compose-local.yml up -d --build
FROM node:22-alpine
WORKDIR /app
COPY build ./build
COPY node_modules ./node_modules
COPY server.js package.json ./
ENV PORT=5050 \
  NODE_ENV=production \
  ADDON=false
EXPOSE 5050
CMD ["node", "server.js"]
